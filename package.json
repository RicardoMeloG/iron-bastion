{
  "name": "iron-bastion",
  "version": "0.2.0",
  "description": "Iron Bastion: tower defense militar en 3D para el navegador (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:rigs": "node tools/asset-pipeline/validate-rig.mjs",
    "check:aim": "node scripts/check-aim.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm test && npm run check:boundaries && npm run check:rigs && npm run build",
    "walkthrough": "node scripts/walkthrough.mjs",
    "simulate": "node scripts/simulate.mjs",
    "assets:normalize": "node tools/asset-pipeline/normalize.mjs",
    "assets:inspect": "node tools/asset-pipeline/inspect.mjs",
    "assets:import": "node tools/asset-pipeline/import-trellis.mjs",
    "assets:code": "node tools/asset-pipeline/build-code-models.mjs",
    "record:gameplay": "node scripts/record-gameplay.mjs",
    "registro": "node scripts/registro.mjs"
  },
  "dependencies": {
    "three": "^0.162.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^0.22.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "vite": "^5.4.0"
  },
  "license": "MIT"
}
